<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>55 Club - Color & Number Prediction Engine (With Visible Control)</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- Canvas Confetti Library -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandDark: '#0b0e14',
            cardBg: '#161b26',
            cardBorder: '#232a3b',
            accentGold: '#f39c12',
            neonGreen: '#00e676',
            neonRed: '#ff1744',
            neonViolet: '#ab47bc'
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbars */
    ::-webkit-scrollbar { height: 6px; width: 6px; }
    ::-webkit-scrollbar-track { background: #0f121d; }
    ::-webkit-scrollbar-thumb { background: #2a3245; border-radius: 4px; }
    
    button { user-select: none; -webkit-tap-highlight-color: transparent; }
    
    .glass-card {
      background: rgba(22, 27, 38, 0.88);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    
    .gradient-violet-red { background: linear-gradient(135deg, #ab47bc 50%, #ff1744 50%); }
    .gradient-violet-green { background: linear-gradient(135deg, #ab47bc 50%, #00e676 50%); }

    .radar-sweep { position: relative; }
    .radar-sweep::after {
      content: '';
      position: absolute;
      width: 100%; height: 100%; top: 0; left: 0;
      border-radius: 50%;
      border: 1px solid rgba(0, 230, 118, 0.6);
      animation: radarPing 1.8s infinite;
    }
    @keyframes radarPing {
      0% { transform: scale(1); opacity: 0.8; }
      100% { transform: scale(2.2); opacity: 0; }
    }

    /* Pulse highlight for Three-Dot Admin Menu */
    .admin-glow {
      box-shadow: 0 0 15px rgba(243, 156, 18, 0.6);
      animation: pulseGlow 2s infinite;
    }
    @keyframes pulseGlow {
      0% { box-shadow: 0 0 8px rgba(243, 156, 18, 0.4); }
      50% { box-shadow: 0 0 18px rgba(243, 156, 18, 0.9); }
      100% { box-shadow: 0 0 8px rgba(243, 156, 18, 0.4); }
    }
  </style>
</head>
<body class="bg-brandDark text-gray-100 min-h-screen flex justify-center items-center font-sans antialiased p-0 sm:p-4">

